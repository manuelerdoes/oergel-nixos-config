# Machine-specific settings for "lib747". The hostname is the folder name.
# Generated by setup.sh on 2026-11-03. Edit freely, or run setup.sh again.
{ pkgs, username, ... }:
{
  imports = [ ./hardware-configuration.nix ];

  # ---------------------------------------------------------------- Bootloader
  # Secure Boot with your own keys (Lanzaboote). It takes systemd-boot's
  # place and signs the bootloader and kernels with the keys in
  # /var/lib/sbctl. Setup steps: README, "Secure Boot".
  boot.lanzaboote = {
    enable = true;
    pkiBundle = "/var/lib/sbctl";
    configurationLimit = 10; # keeps the EFI partition from filling up
  };
  # No editing of the kernel command line in the boot menu.
  boot.loader.systemd-boot.editor = false;
  boot.loader.efi.canTouchEfiVariables = true;
  environment.systemPackages = [ pkgs.sbctl ]; # sbctl status, verify, enroll-keys

  # ------------------------------------------------------------ Text console
  # The console (and tuigreet on it) is created once at boot, sized for the
  # laptop panel, before the dock's monitors show up; it never resizes. At
  # 2880x1800 the 1920x1200 external screens only showed a zoomed-in corner.
  # Running the panel at 1920x1200 for the console makes it fit the external
  # screens exactly; on the laptop it is upscaled (a bit soft, like scale 1.5).
  # Mango and Umbriel set their own resolutions, so this only affects the console.
  boot.kernelParams = [ "video=eDP-1:1920x1200" ];

  # ----------------------------------------------------------------- Dual boot
  # Windows is on the same EFI partition, so systemd-boot lists it by itself.
  # Show the menu long enough to pick it.
  boot.loader.timeout = 5;
  # Windows keeps the hardware clock in local time. Doing the same keeps the
  # clock right in both systems (Kerberos needs a correct clock).
  time.hardwareClockInLocalTime = true;

  # Set once at install time; never change it, even when you update NixOS.
  system.stateVersion = "26.05";
  home-manager.users.${username}.home.stateVersion = "26.05";
}
