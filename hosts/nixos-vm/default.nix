# Machine-specific settings for "nixos-vm" (the VMware test VM).
# The hostname is the folder name. setup.sh can regenerate this file.
{ username, ... }:
{
  imports = [
    # Generated by the installer (setup.sh copies it from /etc/nixos/).
    ./hardware-configuration.nix
  ];

  # ---------------------------------------------------------------- Bootloader
  # BIOS VM: GRUB on the whole disk. Keep 10 entries so /boot doesn't fill up.
  boot.loader.grub.enable = true;
  boot.loader.grub.device = "/dev/sda";
  boot.loader.grub.configurationLimit = 10;

  # -------------------------------------------------------------- Guest tools
  # VMware Tools (open-vm-tools): clean shutdown from the VMware menu, time
  # sync, host/guest communication, and the vmblock mount used for copy-paste.
  virtualisation.vmware.guest = {
    enable = true;
    # Defaults to true when X11 is off, which would leave out vmware-user
    # (clipboard sharing). The compositors start it through Xwayland.
    headless = false;
  };

  # ------------------------------------------------------- VM graphics quirks
  # Many virtual GPUs can't draw a hardware cursor (invisible mouse pointer).
  environment.sessionVariables.WLR_NO_HARDWARE_CURSORS = "1";
  # The compositors can't use the GPU buffers that apps hand them in this VM,
  # so they disconnect the app (Noctalia, kitty...). Make apps draw on the CPU
  # instead; the compositor itself still uses the GPU.
  # environment.sessionVariables.LIBGL_ALWAYS_SOFTWARE = "1";
  # If the compositor itself can't start (no 3D at all), also add:
  # environment.sessionVariables.WLR_RENDERER_ALLOW_SOFTWARE = "1";

  # Set once at install time; never change it, even when you update NixOS.
  system.stateVersion = "26.05";
  home-manager.users.${username}.home.stateVersion = "26.05";
}
