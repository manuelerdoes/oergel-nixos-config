# Everything specific to the test VM.
{ ... }:
{
  imports = [
    # Generated by the installer. Copy it here from /etc/nixos/ (see README).
    ./hardware-configuration.nix
  ];

  networking.hostName = "nixos-vm";

  # ---------------------------------------------------------------- Bootloader
  # Copy whatever your installer put in /etc/nixos/configuration.nix.
  # UEFI VM (most common):
  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;
  # BIOS/legacy VM instead: delete the two lines above and use
  # boot.loader.grub.enable = true;
  # boot.loader.grub.device = "/dev/sda";

  # -------------------------------------------------------------- Guest tools
  # VMware Tools (open-vm-tools): clean shutdown from the VMware menu, time
  # sync, host/guest communication, and the vmblock mount used for copy-paste.
  virtualisation.vmware.guest = {
    enable = true;
    # Defaults to true when X11 is off, which would leave out vmware-user
    # (clipboard sharing). The compositors start it through Xwayland.
    headless = false;
  };
  # Other hypervisors instead:
  # virtualisation.virtualbox.guest.enable = true;
  # virtualisation.hypervGuest.enable = true;
  # services.qemuGuest.enable = true;

  # ------------------------------------------------------- VM graphics quirks
  # Many virtual GPUs can't draw a hardware cursor (invisible mouse pointer).
  environment.sessionVariables.WLR_NO_HARDWARE_CURSORS = "1";
  # If Umbriel won't start because there is no 3D acceleration, try this
  # (very slow, but it shows whether the rest of the setup works):
  # environment.sessionVariables.WLR_RENDERER_ALLOW_SOFTWARE = "1";

  # Use the value from your installer's /etc/nixos/configuration.nix and
  # never change it afterwards, even when you update NixOS.
  system.stateVersion = "26.05";
}
